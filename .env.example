# Local contract testing. Production refuses to start with demo by default.
APP_ENV=development
AGENT_BACKEND=demo
HOST_PORT=80

# Evaluator timeout is 300 seconds. Keep the app budget below it.
REQUEST_TIMEOUT_SECONDS=270
UPSTREAM_TIMEOUT_SECONDS=250
CACHE_DB_PATH=data/runtime/answers.sqlite3
CACHE_NAMESPACE=pension-agent-v1
CACHE_MAX_ENTRIES=1000
KNOWLEDGE_DIR=data/knowledge
PRODUCT_EVIDENCE_PATH=data/structured/product_evidence.json
SOURCE_GOVERNANCE_PATH=data/structured/general_source_governance.json
SYSTEM_PROMPT_PATH=agents/prompts/system.md
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=7500

# Direct HyperCLOVA X mode. Copy the exact endpoint/model from the team's
# CLOVA Studio console; use {model} in the URL only when the endpoint requires it.
HCX_API_URL=
HCX_API_KEY=
HCX_MODEL=
HCX_API_STYLE=clova-v3
HCX_API_KEY_HEADER=Authorization
HCX_API_KEY_PREFIX=Bearer
# The v3 API accepts a unique request ID on every call.
HCX_REQUEST_ID_HEADER=X-NCP-CLOVASTUDIO-REQUEST-ID
HCX_EXTRA_HEADERS_JSON={}
HCX_MAX_TOKENS=4096
HCX_TEMPERATURE=0.1
HCX_THINKING_EFFORT=none

# Existing Agent adapter mode (AGENT_BACKEND=http).
AGENT_UPSTREAM_URL=
AGENT_UPSTREAM_METHOD=POST
AGENT_UPSTREAM_BEARER_TOKEN=
AGENT_UPSTREAM_HEADERS_JSON={}
# Required with the http backend in production. This is an explicit compliance
# attestation and a deployment identity used to isolate cached answers.
AGENT_UPSTREAM_HCX_ONLY=false
AGENT_UPSTREAM_VERSION=
